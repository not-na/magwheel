# This file is the application Kconfig entry point. All application Kconfig
# options can be defined here or included via other application Kconfig files.
# You can browse these options using the west targets menuconfig (terminal) or
# guiconfig (GUI).

menu "Zephyr"
source "Kconfig.zephyr"
endmenu

module = APP
module-str = APP
source "subsys/logging/Kconfig.template.log_config"


menu "Main application configuration"

config MAGWHEEL_CDC
    bool "Enable CDC ACM debug UART"
    default y
    depends on USB_DEVICE_STACK_NEXT
    select SERIAL
    select USBD_CDC_ACM_CLASS
    select UART_CONSOLE
    select LOG_BACKEND_UART
    select UART_LINE_CTRL
    help
        Enable the USB CDC ACM virtual UART used for the console, shell,
        and UART logging backend.

config USB_VID
    hex "USB Vendor ID"
    default 0x1209
    help
        USB Vendor ID for the device.

config USB_PID
    hex "USB Product ID"
    default 0x0001
    help
        USB Product ID for the device.

config USB_MANUFACTURER
    string "USB Manufacturer"
    default "not-na"
    help
        USB Manufacturer string for the device.

config USB_PRODUCT
    string "USB Product"
    default "MagWheel"
    help
        USB Product string for the device.

config MAGWHEEL_DEADZONE_DEFAULT
    int "MagWheel Deadzone Default"
    default 4
    help
        Default in LSBs for the encoder to prevent jitter when idle.

config MAGWHEEL_STEPS_PER_REV
    int "MagWheel Steps Per Revolution"
    default 3600
    help
        Number of steps per revolution for the encoder.

config MAGWHEEL_HID_RESOLUTION
    int "MagWheel HID Resolution"
    default 60
    help
        Resolution of the HID reports in steps per revolution.

menuconfig MAGWHEEL_SPEEDSCALING
    bool "Enable MagWheel speed-dependent scaling"
    depends on TIMER_HAS_64BIT_CYCLE_COUNTER
    select REQUIRES_FLOAT_PRINTF
    default y
    help
        Enable speed scaling for the MagWheel.

        The highest speed is determined by the normal config.

        Scaling is implemented by adding a multiplier to the steps at high speeds,
        reporting a lower HID resolution normally.

if MAGWHEEL_SPEEDSCALING

config MAGWHEEL_SPEEDSCALING_FACTOR
    int "Factor from highest to lowest speed"
    default 5
    help
        Increases the speed by this factor at high speeds.

config MAGWHEEL_SPEEDSCALING_THRESHOLD_LOW
    int "Low Speed threshold for scaling"
    default 1500
    help
        The speed threshold in steps per second below which to apply the low speed scaling.

config MAGWHEEL_SPEEDSCALING_THRESHOLD_HIGH
    int "High Speed threshold for scaling"
    default 6000
    help
        The speed threshold in steps per second above which to apply the maximum speed.

config MAGWHEEL_SPEEDSCALING_SMOOTHING
    int "Averaging duration for speed measurement in samples"
    default 10
    help
        Speed for scaling is measured as the average speed over this duration. A sample
        is usually taken every 5ms.

endif # MAGWHEEL_SPEEDSCALING

endmenu
